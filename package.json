{
  "name": "typescript-for-ai-development",
  "version": "1.0.0",
  "description": "Seven focused days that take you from a bare TypeScript project to a deployed, multi-tool AI agent, reusing everything you already know about types, validation, and testing from Python, and mapping it explicitly onto the TypeScript/Node ecosystem as you go.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"npx tsc --watch\" \"node --watch-path=./dist dist/sonar/main.js\"",
    "dev:server": "jiti src/sonar/main.ts",
    "build": "npx tsc",
    "watch": "npx tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "format:fix": "prettier --write src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ezzaldin97/typescript-for-AI-development.git"
  },
